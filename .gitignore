# Dataset is read-only and lives outside version control (VLSP data agreement)
VLSP2025-MLQA-Natural/
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# local API usage logs (tokens, cost); never committed
logs/

# gold-intent working files hold dataset question text: local only (gold keeps ids + programs)
# (the whole folder, so copies such as review.backup.csv stay local too)
data/annotations/gold_intents_v1/*
!data/annotations/gold_intents_v1/gold_intents_v1.jsonl
!data/annotations/gold_intents_v1/gold_intents_v2.jsonl

# gold-sign working files (drafts with model replies, label YAMLs, review sheet): local only;
# gold_signs_v1.jsonl keeps image ids and labels. Private labels (plan D1, C2) never leave this machine.
data/annotations/gold_signs_v1/*
!data/annotations/gold_signs_v1/gold_signs_v1.jsonl
data/annotations/gold_signs_private/

# D10 visual review page (links dataset and law_db images; local only)
data/annotations/visual_review/

# scene cache: model outputs only, keyed by image sha256 + model + effort + prompt version
cache/scenes/
cache/warm/

# perception eval runs (model scenes per image; local only)
eval/runs/

# scene prompt pictograms: resized law_db figures (dataset files), local only;
# the committed manifest prompts/scene/<version>/pictograms.yaml pins their sha256
prompts/scene/*/pictograms/

# phase-5 private run replay records (P4): model outputs only, no gold, no grades;
# read by replay code only, deleted at the end of phase 5
cache/private_run/
reports/

# services/rag: runtime files live here but never in git (docs/plans/rag-import.md)
services/rag/data/
services/rag/artifacts/
services/rag/models/
services/rag/outputs/
services/rag/evidence/
services/rag/reports/
services/rag/.venv/

# app/api local database and uploads
var/

# Docker Compose secrets (API key, passwords): never committed
.env
