# SignCite over HTTPS: Caddy gets and renews the certificates (Let's Encrypt) by itself.
# DOMAIN comes from .env (e.g. signcite.xyz). Browsers allow the microphone and camera only over HTTPS.
{$DOMAIN} {
	# nginx (`web`) still serves the UI and forwards the API; Caddy only adds TLS in front of it.
	# No compression here: it would hold back the answer stream. Flush every chunk at once.
	reverse_proxy web:80 {
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# The admin site (docs/plans/admin-page.md): nginx's admin server on port 81, with its own login.
# Needs an A record for admin.<domain>; until it exists Caddy keeps retrying its certificate and the
# main site is unaffected.
admin.{$DOMAIN} {
	reverse_proxy web:81
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
