# Copy to .env and edit. Every value has a default; a clean machine needs no .env at all.
# .env holds secrets: it is gitignored and never committed.

# fake (default): the real API code with a fake pipeline, no API key, no Claude spend
# real: the phase52 pipeline (use docker-compose.real.yml as well; see docs/deploy.md)
VQA_PIPELINE=fake

# only for VQA_PIPELINE=real
ANTHROPIC_API_KEY=
VQA_SPEND_LIMIT=2              # USD per API process; the spend guard stops answers above it
VQA_ANSWER_FALLBACK=off        # off | claude | rag
VQA_RAG_URL=http://rag:8100    # the RAG service (e.g. through an SSH tunnel to the GPU box)

# the public port of the UI, and an optional shared password for the whole site
WEB_PORT=8080
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# change these on a server
POSTGRES_PASSWORD=vqa-local
GRAFANA_ADMIN_PASSWORD=admin

# only for the gpu profile (the RAG service on an NVIDIA machine)
HF_TOKEN=
